# 阿里云百炼 OpenAI 兼容接口
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
# 可选：从项目目录以外启动时，指定 agent-skills-ppt 的绝对路径
AGENT_SKILLS_PPT_ROOT=

# Agent 最多调用模型的轮数
MAX_AGENT_TURNS=8

# 可选：PPTX 预览渲染器路径。命令在 PATH 中可用时无需配置。
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# PDFTOPPM_PATH=/absolute/path/to/pdftoppm
# 可选：仅在 LibreOffice 无法发现中文字体时配置。
# FC_CACHE_PATH=/absolute/path/to/fc-cache
# FONTCONFIG_FILE=/absolute/path/to/fonts.conf
